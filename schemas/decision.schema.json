{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jolillie/acip/schemas/decision.schema.json",
  "title": "ACIP checker decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "reason_code", "source", "confidence", "summary"],
  "properties": {
    "decision": {"enum": ["allow", "clarify", "deny"]},
    "reason_code": {
      "enum": [
        "none",
        "ambiguous_boundary",
        "authority_override",
        "indirect_instruction",
        "protected_context_request",
        "unauthorized_action",
        "encoded_instruction",
        "multi_turn_escalation"
      ]
    },
    "source": {"enum": ["direct", "indirect", "mixed", "none"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "summary": {"type": "string", "minLength": 1, "maxLength": 240}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "allow"}}, "required": ["decision"]},
      "then": {"properties": {"reason_code": {"const": "none"}, "source": {"const": "none"}}}
    },
    {
      "if": {"properties": {"decision": {"const": "clarify"}}, "required": ["decision"]},
      "then": {"properties": {"reason_code": {"const": "ambiguous_boundary"}, "source": {"enum": ["direct", "indirect", "mixed"]}}}
    },
    {
      "if": {"properties": {"decision": {"const": "deny"}}, "required": ["decision"]},
      "then": {
        "properties": {
          "reason_code": {"enum": ["authority_override", "indirect_instruction", "protected_context_request", "unauthorized_action", "encoded_instruction", "multi_turn_escalation"]},
          "source": {"enum": ["direct", "indirect", "mixed"]}
        }
      }
    }
  ]
}
